      { "command": "virga.scratch.keybindingPadding" },
      {
        "key": "ctrl+s",
        "mac": "cmd+s",
        "command": "virga.scratch.run",
        "when": "editorTextFocus && resourceScheme == file && resourceFilename =~ /^scratch-[0-9]+\\.(apex|soql)$/ && resourceDirname =~ /\\.sfdx.virga-scratch$/"
      }
    ],
    "configuration": {
      "title": "Virga",
      "properties": {
        "virga.scratch.timeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 1,
          "maximum": 86400,
          "markdownDescription": "How long one `sf` run of a scratch may take before it is stopped (at most 86400 s, one day).",
          "scope": "resource"
        },
        "virga.scratch.maxColumnWidth": {
          "type": "number",
          "default": 40,
          "minimum": 4,
          "markdownDescription": "Widest column of a SOQL result table; longer values end with `…`.",
          "scope": "resource"
        },
        "virga.scratch.clearOutputOnRun": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Clear the **Virga** output before every run. Off keeps earlier results above the new one.",
          "scope": "resource"
        }
      }
    },
    "configurationDefaults": {
      "[apex-anon]": {
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 100,
        "files.autoSaveWhenNoErrors": false,
        "files.autoSaveWorkspaceFilesOnly": false
      },
      "[soql]": {
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 100,
        "files.autoSaveWhenNoErrors": false,
        "files.autoSaveWorkspaceFilesOnly": false
      }
    },
    "languages": [
      {
        "id": "apex-anon",
        "extensions": [
          ".apex"
        ]
      },
      {
        "id": "soql",
        "extensions": [
          ".soql"
        ]
      },
      {
        "id": "virga-output",
        "aliases": [
          "Virga Output"
        ],
        "mimetypes": [
          "text/x-code-output"
        ]
      }
    ],
    "grammars": [
      {
        "language": "virga-output",
        "scopeName": "source.virga-output",
        "path": "./syntaxes/virga-output.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "apex",
        "path": "./snippets/apex.code-snippets"
      },
      {
        "language": "soql",
        "path": "./snippets/soql.code-snippets"
      }
    ]
  },
  "vsce": {
    "dependencies": false
  },
  "scripts": {
    "test": "node test/run.js",
    "e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File e2e/e2e.ps1",
    "e2e:vsix": "powershell -NoProfile -ExecutionPolicy Bypass -File e2e/e2e.ps1 -FromVsix",
    "screenshots": "powershell -NoProfile -ExecutionPolicy Bypass -File e2e/e2e.ps1 -Screenshots",
    "package": "npx --yes @vscode/vsce@3 package"
  }
}
