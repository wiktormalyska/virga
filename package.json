{
  "name": "virga",
  "displayName": "Virga: Apex Scratch & Quick Fixes",
  "description": "Write some Apex or SOQL, press Ctrl+S to run it, then close the tab and it's gone. Completion for local types, quick fixes and Apex snippets. Works with Salesforce CLI and the Salesforce Extension Pack.",
  "version": "0.1.0",
  "publisher": "wiktormalyska",
  "author": {
    "name": "Wiktor Małyska"
  },
  "license": "MIT",
  "pricing": "Free",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#16202e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wiktormalyska/virga.git"
  },
  "bugs": {
    "url": "https://github.com/wiktormalyska/virga/issues"
  },
  "homepage": "https://github.com/wiktormalyska/virga#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Other"
  ],
  "keywords": [
    "apex",
    "soql",
    "anonymous apex",
    "execute anonymous",
    "salesforce",
    "sf cli",
    "sfdx",
    "snippets",
    "scratch",
    "quick fix",
    "completion",
    "invocable"
  ],
  "activationEvents": [
    "workspaceContains:sfdx-project.json",
    "onLanguage:apex"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "virga.scratch.newApex",
        "title": "New Anonymous Apex Scratch",
        "category": "Virga",
        "icon": "$(play)"
      },
      {
        "command": "virga.scratch.newSoql",
        "title": "New SOQL Scratch",
        "category": "Virga",
        "icon": "$(database)"
      },
      {
        "command": "virga.scratch.run",
        "title": "Run Scratch",
        "category": "Virga",
        "icon": "$(play)"
      },
      {
        "command": "virga.scratch.showOutput",
        "title": "Show Output",
        "category": "Virga"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "virga.scratch.run",
          "when": "resourceScheme == file && resourceFilename =~ /^scratch-[0-9]+\\.(apex|soql)$/ && resourceDirname =~ /\\.sfdx.virga-scratch$/"
        }
      ],
      "editor/title/run": [
        {
          "command": "virga.scratch.run",
          "when": "resourceScheme == file && resourceFilename =~ /^scratch-[0-9]+\\.(apex|soql)$/ && resourceDirname =~ /\\.sfdx.virga-scratch$/",
          "group": "navigation@0"
        }
      ]
    },
    "keybindings": [
      { "command": "virga.scratch.keybindingPadding" },
      { "command": "virga.scratch.keybindingPadding" },
